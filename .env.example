# ==========================================
# WIBUFLIX ENVIRONMENT VARIABLES (EXAMPLE)
# ==========================================
# SALIN FILE INI MENJADI .env DAN ISI DENGAN DATA ASLI ANDA.
# JANGAN PERNAH MEMPUBLIKASIKAN ATAU MENG-COMMIT FILE .env ASLI KE GITHUB!
# DI AZURE APP SERVICE / CONTAINER APPS, ISI VARIABEL INI DI PORTAL AZURE (CONFIGURATION -> ENVIRONMENT VARIABLES).

# Server Port & Environment
PORT=3000
NODE_ENV=production

# Database MongoDB
MONGO_URI="mongodb+srv://username:password@cluster0.example.mongodb.net/wibuflix?retryWrites=true&w=majority"

# Nanime ID Cookie Authentication (Untuk Akses Link Download & VIP)
# Contoh format: "nanime_session=xxxxxx; remember_web_xxxxxx=xxxxxx;"
NANIME_COOKIE=""

# TMDB API Key (Untuk Enrichment Metadata)
TMDB_API_KEY=""

# Azure Blob Storage (Untuk VOD HLS/Video Upload & Streaming)
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=youraccount;AccountKey=yourkey==;EndpointSuffix=core.windows.net"
AZURE_CONTAINER_NAME="videos"
